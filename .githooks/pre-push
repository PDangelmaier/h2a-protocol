#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
"$REPO_ROOT/.claude/hooks/ac-check.sh"

# V2 (REVIEW-015): run db:verify when supabase/ files changed
while read local_ref local_oid remote_ref remote_oid; do
  if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
    range="$local_oid"
  else
    range="$remote_oid..$local_oid"
  fi
  if git diff --name-only "$range" -- 'supabase/' | grep -q .; then
    echo "[pre-push] supabase/ changed — running db:verify..."
    if ! command -v docker >/dev/null 2>&1; then
      echo "ERROR: Docker not available. db:verify requires Docker to test migrations."
      echo "Install Docker or run 'npm run db:verify' manually before pushing."
      exit 1
    fi
    if ! docker info >/dev/null 2>&1; then
      echo "ERROR: Docker daemon not running. db:verify requires a running Docker daemon."
      echo "Start Docker and retry, or run 'npm run db:verify' manually."
      exit 1
    fi
    "$REPO_ROOT/scripts/db-verify.sh"
    break
  fi
done
